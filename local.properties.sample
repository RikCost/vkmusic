# Скопируйте в local.properties и заполните своими значениями.
# local.properties в .gitignore — реальные ключи в репозиторий не попадут.
sdk.dir=D\:/Repository/Anime/.android-sdk

# Реквизиты эталонного Android-клиента VK ID (извлечены из его APK, см. docs/vk-auth.md).
# Без них вход по паролю недоступен и приложение работает только в демо-режиме.
vk.clientId=
vk.clientSecret=
