# Скопируйте в keystore.properties и укажите свой ключ подписи релиза.
# keystore.properties и *.jks в .gitignore — в репозиторий не попадают.
# Без этого файла release собирается неподписанным, debug работает как обычно.
storeFile=D\:/path/to/muvk-release.jks
storePassword=changeme
keyAlias=muvk
keyPassword=changeme
